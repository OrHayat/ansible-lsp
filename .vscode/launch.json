{
  "version": "0.2.0",
  "configurations": [
    {
      // First in the list, so a bare F5 picks it. Attaching the debugger is what
      // makes the other config slow: measured on 1.135.0, fork -> "Extension host
      // started" is 237ms here against 1443ms with the debugger, because the adapter's
      // `Debugger.enable` makes V8 recompile the whole 2.2MB extensionHostProcess
      // bundle with debug instrumentation. Nothing else differs — `--inspect` on its
      // own costs nothing until something connects to it.
      "name": "Run extension against demo folder (no debugger)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      // The server is a build artefact the launch does not otherwise rebuild — see
      // tasks.json for what happens without this.
      "preLaunchTask": "build ansible-lsp (release)",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/client",
        "${workspaceFolder}/demo",
      ],
      "outFiles": []
    },
    {
      // Only worth the 1.2s when you actually need breakpoints in client/src/extension.js.
      // The server is Rust and this debugger cannot step into it either way.
      "name": "Run extension against demo folder (debugger)",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "build ansible-lsp (release)",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/client",
        "${workspaceFolder}/demo",
      ],
      "outFiles": []
    }
  ]
}
