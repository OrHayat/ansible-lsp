{
  "name": "Jinja",
  "scopeName": "source.jinja",
  "comment": "Hand-written for this extension; nothing vendored. Deliberately small \u2014 it paints the delimiter shapes instantly and while the server is down, and `textDocument/semanticTokens` refines the cases regex cannot reach (delimiters overridden by a `#jinja2:` header or inherited from a `template:` call site, and line statements).",
  "patterns": [
    {
      "include": "#raw"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#statement"
    },
    {
      "include": "#interpolation"
    }
  ],
  "repository": {
    "raw": {
      "comment": "First, and it matters: inside a raw body there is no tag grammar at all, so a `{%` that opens nothing is ordinary text. A begin/end rule holds that across lines. Getting this wrong is T-216 as colour \u2014 `printf \"x{%s}\"` inside a raw body must not paint as a tag.",
      "begin": "\\{%[-+]?\\s*raw\\s*[-+]?%\\}",
      "end": "\\{%[-+]?\\s*endraw\\s*[-+]?%\\}",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.jinja"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.control.jinja"
        }
      }
    },
    "comment": {
      "begin": "\\{#",
      "end": "#\\}",
      "name": "comment.block.jinja"
    },
    "statement": {
      "begin": "\\{%[-+]?",
      "end": "[-+]?%\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.begin.jinja"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.jinja"
        }
      },
      "name": "meta.tag.jinja",
      "patterns": [
        {
          "include": "#tag-name"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "interpolation": {
      "begin": "\\{\\{[-+]?",
      "end": "[-+]?\\}\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.jinja"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.jinja"
        }
      },
      "name": "meta.interpolation.jinja",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "tag-name": {
      "comment": "The 14 statement forms `jinja::statement` reads, plus the block-ending spellings.",
      "match": "\\G\\s*\\b(if|elif|else|endif|for|endfor|block|endblock|extends|include|import|from|macro|endmacro|call|endcall|filter|endfilter|set|endset|with|endwith|autoescape|endautoescape|trans|endtrans|do|break|continue)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.jinja"
        }
      }
    },
    "expression": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#filter"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.single.jinja",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.jinja",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.jinja",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jinja",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "number": {
      "name": "constant.numeric.jinja",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "constant": {
      "name": "constant.language.jinja",
      "match": "\\b([Tt]rue|[Ff]alse|[Nn]one)\\b"
    },
    "filter": {
      "comment": "`x | default(1)` \u2014 the name after a pipe is a filter, not a variable.",
      "match": "(\\|)\\s*([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
      "captures": {
        "1": {
          "name": "keyword.operator.jinja"
        },
        "2": {
          "name": "support.function.filter.jinja"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.jinja",
          "match": "\\b(and|or|not|in|is|if|else|as|with|without|context|recursive)\\b"
        },
        {
          "name": "keyword.operator.jinja",
          "match": "(==|!=|<=|>=|<|>|\\+|-|\\*\\*?|//?|%|~|=)"
        }
      ]
    },
    "variable": {
      "name": "variable.other.jinja",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
