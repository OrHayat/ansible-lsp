{# T-040 — the root of the include chain. All four target-naming tags, each with a literal
   target, which is exactly what `jinja2.meta.find_referenced_templates` reports:

       extends base.conf.j2 · import macros.j2 · from macros.j2 · include partials/header.j2
       · include optional.conf.j2

   Ansible never parses this file at playbook-parse time; a broken tag here is a run-time
   failure on the target host. `broken.conf.j2` is that case. #}
{% extends "base.conf.j2" %}
{# GOOD — `with context` and, on the body block below, `scoped` are painted as keywords. The
   same words outside their statement are variables, which is what they are there. Pinned by
   `highlight.rs::the_demo_paints_its_statement_words_as_keywords`, with `optional.conf.j2`'s
   `ignore missing`. #}
{% import "macros.j2" as m with context %}
{% from "macros.j2" import listen_line %}

{% block header %}
{% include "partials/header.j2" %}
{% endblock %}

{% block body scoped %}
{# GOOD — `decoration` is a keyword argument: it names the filter's parameter, so it is painted
   as one, and it declares nothing — the same word as a bare name later would still be a
   variable. `macros.j2` has the other side, a parameter being defined. Pinned by
   `highlight.rs::the_demo_has_one_keyword_argument_and_one_macro_parameter`. #}
{{ ansible_managed | comment(decoration='# ') }}
{# GOOD — six statements in this file introduce a name, and each is painted as what it
   introduces: `m` a namespace, `listen_line` a function, the two block names labels,
   `listen_port` a variable, and the loop's `h` further down. All carry the `declaration`
   modifier; the reads of them do not.
   `macros.j2` has the other half, a macro name and its parameter. Pinned by
   `highlight.rs::the_chain_root_demo_declares_exactly_these_names`. #}
{% set listen_port = app_port | default(8080) %}
{{ listen_line(listen_port) }}
{# GOOD — the `m` here is painted as a namespace, not a variable, because the `{% import %}`
   above introduced it as one. Source order is the rule: the same `{{ m }}` written above
   the import would be a variable, which is also what it is at render time. Pinned by
   `highlight.rs::the_chain_root_demo_paints_the_imported_namespace_at_its_use`. #}
{{ m.upstream('web') }}
{# GOOD — `hostname` after the dot is a property token, not a variable: the root is looked up
   in the render context, the property on whatever the root turned out to be. `default` after
   the pipe stays a function, and `m.upstream(` above stays a call. Pinned by
   `highlight.rs::the_chain_root_demo_paints_the_dotted_name_as_a_property`. #}
{{ ansible_facts.hostname | default(inventory_hostname) }}
{# GOOD — the first `h` is introduced by the loop and carries the `declaration` modifier.
   `groups` and the `h` in the body are lookups and do not, so a theme can show which name
   has to exist already and which one this line creates. Pinned by
   `highlight.rs::the_chain_root_demo_marks_the_loop_target_as_a_declaration`. #}
{% for h in groups['web'] %}server {{ h }};{% endfor %}
{% include "optional.conf.j2" %}
{% endblock %}
